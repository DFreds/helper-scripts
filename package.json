{
    "name": "helper-scripts",
    "version": "1.0.0",
    "description": "Helper scripts for DFreds modules",
    "private": true,
    "type": "module",
    "scripts": {
        "foundry": "tsx ./build/start-foundry.ts",
        "update-types": "tsx ./build/copy-types-to-modules.ts",
        "stage": "tsx ./build/stage-modules.ts",
        "stage:all": "tsx ./build/stage-modules.ts --all",
        "pull": "tsx ./build/pull-modules.ts",
        "pull:all": "tsx ./build/pull-modules.ts --all",
        "link-modules": "tsx ./build/link-modules-to-foundry.ts",
        "reinstall": "tsx ./build/delete-node-and-reinstall.ts",
        "reinstall:force": "tsx ./build/delete-node-and-reinstall.ts --force",
        "reinstall:all": "tsx ./build/delete-node-and-reinstall.ts --all",
        "sync:all": "npm run pull:all && npm run reinstall:all && npm run stage:all",
        "pack-world-compendiums": "tsx ./build/pack-world-compendiums.ts"
    },
    "author": "DFreds",
    "license": "MIT",
    "engines": {
        "node": ">=24.14.1"
    },
    "devDependencies": {
        "@foundryvtt/foundryvtt-cli": "^3.0.3",
        "@types/node": "^25.6.0",
        "@types/prompts": "^2.4.9",
        "prettier": "^3.8.3",
        "prompts": "^2.4.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    }
}
