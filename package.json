        "@types/prompts": "^2.4.9",
        "@typescript-eslint/eslint-plugin": "^7.13.1",
        "@typescript-eslint/parser": "^7.13.1",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-json": "^4.0.0",
        "eslint-plugin-prettier": "^5.5.5",
        "fs-extra": "^11.2.0",
        "prettier": "^3.8.3",
        "prompts": "^2.4.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
